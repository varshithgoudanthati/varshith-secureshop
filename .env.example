# SecureShop Environment Configuration Template
# Copy this file to .env for local customized configuration.

# Application Mode:
# 'secure' (Default, hardened mode with authorization checks, CSRF, security headers, parameterized queries)
# 'vulnerable' (Educational lab mode enabling controlled OWASP Top 10 vulnerabilities for local testing)
SECURESHOP_MODE=secure

# Flask Settings
FLASK_APP=secureshop
FLASK_ENV=development
SECRET_KEY=secureshop-dev-secret-key-super-secure-token-2026

# Server Network Binding
# Note: For safety, vulnerable mode will ALWAYS bind strictly to 127.0.0.1
HOST=127.0.0.1
PORT=5000

# Database
DATABASE_PATH=instance/secureshop.db

# Security & Rate Limiting Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_NAME=secureshop_session
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
